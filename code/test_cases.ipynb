# Define your points
x1, y1 = mu_min, P_min
x2, y2 = mu_crit, P_crit

x_points = mu_quark_2
y_points = P_quark_2

# Define the quadratic function
def quadratic(x, a, b):
    return a * (x - x2)**2 + b * (x - x2) + y2

# Objective function: sum of squared differences
def objective(params):
    a, b = params
    y_quadratic = quadratic(x_points, a, b)
    # Find the point of intersection by minimizing the distance to the curve
    return np.sum((y_quadratic - y_points)**2)

# Initial guess for parameters
initial_guess = [1, 1]

# Constraints to pass through (x1, y1)
def constraint(params):
    a, b = params
    return quadratic(x1, a, b) - y1

# Define the constraint in the form required by 'minimize'
cons = {'type': 'eq', 'fun': constraint}

# Perform the optimization
result = minimize(objective, initial_guess, constraints=cons)

# Extract optimized parameters
a_opt, b_opt = result.x

print(f"Optimized coefficients: a = {a_opt}, b = {b_opt}")
